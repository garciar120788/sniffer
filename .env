# =====================================================================
#  CONFIGURACIÓN DEL CAPTURADOR DE PAQUETES IPv4
#  Este es el único archivo que debe modificarse para operar la aplicación.
# =====================================================================

# #####################################################################
# >>>>>>>>>>>>>>>  MODIFIQUE AQUÍ LA INTERFAZ DE RED  <<<<<<<<<<<<<<<<
# #####################################################################
#
# Indique el nombre exacto de la interfaz que se va a monitorear.
# Para consultar los nombres de las interfaces del equipo, ejecute:
#
#     ip -br addr
#
# o bien:
#
#     docker compose run --rm sniffer interfaces
#
# Ejemplos (sustitúyalos por los nombres de las interfaces del equipo):
#   CAPTURE_IFACE=enp1s0                  -> Interfaz Ethernet 1
#   CAPTURE_IFACE=enp2s0                  -> Interfaz Ethernet 2
#   CAPTURE_IFACE=wlp3s0                  -> Interfaz inalámbrica (Wi-Fi)
#   CAPTURE_IFACE=enp1s0,enp2s0,wlp3s0    -> Varias interfaces simultáneamente
#
CAPTURE_IFACE=enp1s0
#
# #####################################################################


# ---------------------------------------------------------------------
# Parámetros de captura (opcionales)
# ---------------------------------------------------------------------
# Filtro BPF adicional. Siempre se combina con "ip" (solo IPv4).
# Ejemplos: "tcp", "udp port 53", "host 8.8.8.8", "not port 22"
CAPTURE_FILTER=

# Número de paquetes tras el cual se detiene la captura (0 = sin límite)
CAPTURE_COUNT=0

# Duración máxima de la captura en segundos (0 = sin límite; se detiene con Ctrl+C)
CAPTURE_TIMEOUT=0

# Intervalo en segundos entre los mensajes de progreso (0 = desactivado)
STATS_INTERVAL=5

# Parámetros de escritura por lotes en la base de datos
BATCH_SIZE=500
FLUSH_INTERVAL=1
QUEUE_SIZE=100000

# ---------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------
DB_NAME=sniffer
DB_USER=sniffer
DB_PASSWORD=sniffer
# Puerto publicado únicamente en 127.0.0.1 del equipo anfitrión. Modifíquelo
# si otro servicio PostgreSQL ya utiliza el puerto 5432 (por ejemplo, 5433).
DB_PORT=5432
